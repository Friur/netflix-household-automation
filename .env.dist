# =============================================================================
# IMAP
# =============================================================================
IMAP_USER="changeme"

# ATENÇÃO (Gmail e Outlook): com verificação em duas etapas ativa, a sua senha
# normal NÃO funciona aqui. É preciso gerar uma Senha de App:
# https://myaccount.google.com/apppasswords
IMAP_PASSWORD="changeme"

# Ex.: imap.gmail.com (Gmail), outlook.office365.com (Outlook)
IMAP_HOST="changeme"

# IMAP sobre TLS usa a porta 993 na prática totalidade dos provedores.
IMAP_PORT="993"

# Opcional. Deixe vazio para descobrir a lixeira automaticamente.
# A detecção automática hoje cobre Gmail e nomes na raiz (Trash, Lixeira,
# Papelera, Corbeille). Em servidores Dovecot/Yahoo, informe explicitamente —
# nesses o separador costuma ser ponto, ex.: "INBOX.Trash".
IMAP_TRASH_FOLDER=""

# =============================================================================
# Quais e-mails observar
# =============================================================================
# Ambas aceitam vários valores separados por barra vertical ( | ).
# As formas no singular (TARGET_EMAIL_ADDRESS / TARGET_EMAIL_SUBJECT) ainda
# funcionam, mas as no plural têm precedência.

# Atenção: o remetente real da Netflix é o subdomínio account.netflix.com.
# Ex.: "info@account.netflix.com|no-reply@account.netflix.com"
TARGET_EMAIL_ADDRESSES="info@account.netflix.com"

# Ex.: "Como atualizar sua Netflix Household|How to update your Netflix Household"
TARGET_EMAIL_SUBJECTS="changeme"

# =============================================================================
# Modo de simulação
# =============================================================================
# Use DRY_RUN="1" na PRIMEIRA execução, antes de confiar na configuração.
# Nesse modo o programa encontra o e-mail, mostra o assunto que casou e o link
# que abriria — mas não abre o link, não apaga nada e nem marca como lido, de
# forma que o mesmo e-mail continua disponível para a execução real.
# Isso importa porque todo e-mail do remetente monitorado é movido para a
# lixeira: com o assunto configurado errado, o link seria apagado sem uso.
DRY_RUN="0"

# =============================================================================
# Ajuste fino (todos opcionais — os padrões servem para a maioria dos casos)
# =============================================================================
# Sondagem de reserva, em segundos. O IDLE do IMAP já entrega os e-mails por
# push em tempo real; isto é só rede de segurança. Valores baixos gastam cota
# do servidor sem ganho de latência — o Gmail limita comandos por sessão.
# (padrão 60)
POLLING_INTERVAL_SECONDS="60"

# Quantas reconexões seguidas podem falhar antes do processo desistir e sair com
# código 1, deixando o supervisor (Docker restart: unless-stopped) reiniciá-lo.
# O intervalo entre tentativas cresce de 1s até um teto de 5min. (padrão 20)
MAX_RECONNECT_ATTEMPTS="20"

# Teto de e-mails aguardando processamento. Ao estourar, o mais antigo é
# descartado com aviso no log. (padrão 50)
MAX_QUEUE_SIZE="50"
